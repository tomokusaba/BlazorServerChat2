@inherits LayoutComponentBase

<PageTitle>あびや</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="@Assets["_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css"]" />
</HeadContent>

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header" Style="background-color: #185ABD; color: #ffffff;" role="banner">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Left">
            <FluentLabel Typo="Typography.H4" Style="color: #ffffff; font-weight: bold;">あびや</FluentLabel>
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right" VerticalAlignment="VerticalAlignment.Center">
            <LoginDisplay />
            <ThemeSwitch />
        </FluentStack>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation">
        <NavMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content" role="main">
        @Body
    </FluentLayoutItem>
    <FluentToastProvider />
    <FluentDialogProvider />
    <FluentTooltipProvider />
    <FluentMessageBarProvider Section="main" />
    <FluentKeyCodeProvider />
</FluentLayout>

@code {
    public static bool DarkMode = false;
    
    /// <summary>
    /// ダークモード変更時のイベント 🌙
    /// </summary>
    public static event Action? OnDarkModeChanged;
    
    /// <summary>
    /// 外部からイベントを発火するためのメソッド 🎯
    /// </summary>
    public static void RaiseDarkModeChanged() => OnDarkModeChanged?.Invoke();
}