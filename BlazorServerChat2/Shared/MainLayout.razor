<HeadContent>
    <link rel="stylesheet" href="@Assets["_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css"]" />
</HeadContent>
<FluentDesignSystemProvider @ref="_designSystemProvider" AccentBaseColor="#185ABD" BaseLayerLuminance="@_baseLayerLuminance" Style="height:100%">
<FluentLayout Style="height: 100%">

    <FluentHeader Style="background-color: var(--accent-fill-rest);">
        <FluentStack Orientation="Orientation.Horizontal"HorizontalAlignment="HorizontalAlignment.Left">
            <FluentLabel Typo="Typography.H4" Style="color: var(--foreground-on-accent-rest); font-weight: bold;">あびや</FluentLabel>
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right" VerticalAlignment="VerticalAlignment.Center">
            <LoginDisplay />
            <FluentSwitch @bind-Value="@IsDark" @ref="@Switch" />
            <FluentLabel Style="color: var(--foreground-on-accent-rest);">@(IsDark ? "DarkMode" : "LightMode")</FluentLabel>
        </FluentStack>
    </FluentHeader>
    <FluentStack Orientation="Orientation.Horizontal" Width="100%" Style="height:stretch">
        <NavMenu />
        <FluentBodyContent>
            <ChildContent>
                @Body
            </ChildContent>
        </FluentBodyContent>
    </FluentStack>
    <FluentToastProvider />
    <FluentDialogProvider />
    <FluentTooltipProvider />
    <FluentMessageBarProvider />
    <FluentKeyCodeProvider />
</FluentLayout>
</FluentDesignSystemProvider>

@code {
    private FluentDesignSystemProvider? _designSystemProvider;
    private float _baseLayerLuminance = 0.98f;
    private bool IsDarkMode { get; set; } = false;

    public static FluentSwitch? Switch { get; set; }

    private async Task OnChange(ChangeEventArgs e)
    {
        if (!IsDarkMode)
        {
            _baseLayerLuminance = 0.15f;
        }
        else
        {
            _baseLayerLuminance = 0.98f;
        }
        StateHasChanged();
        await Task.CompletedTask;
    }

    public static bool DarkMode = false;
    
    /// <summary>
    /// ダークモード変更時のイベント
    /// </summary>
    public static event Action? OnDarkModeChanged;

    public bool IsDark
    {
        get => DarkMode;
        set
        {
            DarkMode = value;

            if (value)
            {
                _baseLayerLuminance = StandardLuminance.DarkMode.GetLuminanceValue();
            }
            else
            {
                _baseLayerLuminance = StandardLuminance.LightMode.GetLuminanceValue();
            }
            StateHasChanged();
            
            // イベントを発火して他のコンポーネントに通知
            OnDarkModeChanged?.Invoke();
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // FluentDesignSystemProviderのBaseLayerLuminanceプロパティで制御するため、
        // OnAfterRenderAsyncでのJS Interop呼び出しは不要
        return Task.CompletedTask;
    }
}