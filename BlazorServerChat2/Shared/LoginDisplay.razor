<AuthorizeView>
    <Authorized>
        <FluentLabel Style="color: var(--foreground-on-accent-rest);">
            @context.User.Identity?.Name　さん
        </FluentLabel>
        <form method="post" action="Identity/Account/LogOut">
            <FluentButton type="ButtonType.Submit" Appearance="Appearance.Neutral">ログアウト</FluentButton>
        </form>
    </Authorized>
    <NotAuthorized>
        <FluentAnchor Href="Identity/Account/Register" Style="color: var(--foreground-on-accent-rest);">あびや登録</FluentAnchor>
        <FluentAnchor Href="Identity/Account/Login" Style="color: var(--foreground-on-accent-rest);">ログイン</FluentAnchor>
    </NotAuthorized>
</AuthorizeView>
