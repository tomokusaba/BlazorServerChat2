<AuthorizeView>
    <Authorized>
        <FluentLabel Style="color: #ffffff;">
            @context.User.Identity?.Name　さん
        </FluentLabel>
        <form method="post" action="Identity/Account/LogOut">
            <FluentButton type="ButtonType.Submit" Appearance="ButtonAppearance.Default" AriaLabel="ログアウト">ログアウト</FluentButton>
        </form>
    </Authorized>
    <NotAuthorized>
        <FluentLink Href="Identity/Account/Register" Style="color: #ffffff;" AriaLabel="あびや登録">あびや登録</FluentLink>
        <FluentLink Href="Identity/Account/Login" Style="color: #ffffff;" AriaLabel="ログイン">ログイン</FluentLink>
    </NotAuthorized>
</AuthorizeView>
