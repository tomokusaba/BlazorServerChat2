@page
@using System.Buffers.Text
@using Microsoft.AspNetCore.Identity
@model BlazorServerChat2.Areas.Identity.Pages.Account.Manage.PasskeysModel
@{
    ViewData["Title"] = "パスキー管理";
    ViewData["ActivePage"] = ManageNavPages.Passkeys;
}

<h3>@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

@if (Model.CurrentPasskeys?.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>パスキー名</th>
                <th>作成日</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var passkey in Model.CurrentPasskeys)
            {
                var credentialId = Base64Url.EncodeToString(passkey.CredentialId);
                <tr>
                    <td>@(passkey.Name ?? "名前なしパスキー")</td>
                    <td>@passkey.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                    <td>
                        <form method="post" asp-page-handler="Rename" class="d-inline">
                            <input type="hidden" name="CredentialId" value="@credentialId" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">名前変更</button>
                        </form>
                        <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('このパスキーを削除しますか？');">
                            <input type="hidden" name="CredentialId" value="@credentialId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">削除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>登録されているパスキーはありません。</p>
}

<hr />

<h4>新しいパスキーを追加</h4>

@if (Model.CurrentPasskeys?.Count >= 100)
{
    <p class="text-danger">パスキーの最大数に達しました。新しいパスキーを追加する前に、既存のパスキーを削除してください。</p>
}
else
{
    <button type="button" id="add-passkey" class="btn btn-primary">
        🔐 新しいパスキーを追加
    </button>
}

@section Scripts {
    <script>
        document.getElementById('add-passkey')?.addEventListener('click', async function() {
            try {
                // パスキー作成オプションを取得
                const optionsResponse = await fetch('/Account/PasskeyCreationOptions', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (!optionsResponse.ok) {
                    const error = await optionsResponse.json();
                    alert('パスキーオプションの取得に失敗しました: ' + (error.error || 'Unknown error'));
                    return;
                }

                const options = await optionsResponse.json();

                // WebAuthn credentials.create を呼び出し
                const createOptions = {
                    publicKey: {
                        challenge: base64UrlToArrayBuffer(options.challenge),
                        rp: options.rp,
                        user: {
                            id: base64UrlToArrayBuffer(options.user.id),
                            name: options.user.name,
                            displayName: options.user.displayName
                        },
                        pubKeyCredParams: options.pubKeyCredParams,
                        timeout: options.timeout,
                        attestation: options.attestation || 'none',
                        authenticatorSelection: options.authenticatorSelection,
                        excludeCredentials: (options.excludeCredentials || []).map(c => ({
                            id: base64UrlToArrayBuffer(c.id),
                            type: c.type,
                            transports: c.transports
                        }))
                    }
                };

                const credential = await navigator.credentials.create(createOptions);

                if (!credential) {
                    alert('パスキー作成がキャンセルされました');
                    return;
                }

                // credential を JSON に変換してサーバーに送信
                const credentialJson = credentialToJson(credential);

                // パスキーを追加
                const addResponse = await fetch('/Account/AddPasskey', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ credentialJson: credentialJson })
                });

                if (addResponse.ok) {
                    alert('パスキーが正常に追加されました');
                    window.location.reload();
                } else {
                    const error = await addResponse.json();
                    alert('パスキーの追加に失敗しました: ' + (error.error || 'Unknown error'));
                }

            } catch (error) {
                console.error('パスキー追加エラー:', error);
                alert('パスキーの追加に失敗しました: ' + error.message);
            }
        });

        function base64UrlToArrayBuffer(base64Url) {
            const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            const padding = '='.repeat((4 - base64.length % 4) % 4);
            const binary = atob(base64 + padding);
            const bytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) {
                bytes[i] = binary.charCodeAt(i);
            }
            return bytes.buffer;
        }

        function arrayBufferToBase64Url(buffer) {
            const bytes = new Uint8Array(buffer);
            let binary = '';
            for (let i = 0; i < bytes.length; i++) {
                binary += String.fromCharCode(bytes[i]);
            }
            return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
        }

        function credentialToJson(credential) {
            if (typeof credential.toJSON === 'function') {
                try {
                    return JSON.stringify(credential.toJSON());
                } catch (e) {
                    console.warn('credential.toJSON() failed, using manual serialization');
                }
            }

            const response = credential.response;
            const result = {
                id: credential.id,
                rawId: arrayBufferToBase64Url(credential.rawId),
                type: credential.type,
                response: {
                    attestationObject: arrayBufferToBase64Url(response.attestationObject),
                    clientDataJSON: arrayBufferToBase64Url(response.clientDataJSON)
                }
            };

            if (response.getTransports) {
                result.response.transports = response.getTransports();
            }

            if (credential.authenticatorAttachment) {
                result.authenticatorAttachment = credential.authenticatorAttachment;
            }

            return JSON.stringify(result);
        }
    </script>
}
