@page "{id}"
@model BlazorServerChat2.Areas.Identity.Pages.Account.Manage.RenamePasskeyModel
@{
    ViewData["Title"] = "パスキー名の変更";
    ViewData["ActivePage"] = ManageNavPages.Passkeys;
}

<h3>@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="Input.CredentialId" />
            <div class="form-floating mb-3">
                <input asp-for="Input.Name" class="form-control" placeholder="パスキー名" />
                <label asp-for="Input.Name">パスキー名</label>
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">💾 保存</button>
        </form>
        <div class="mt-3">
            <a asp-page="./Passkeys" class="btn btn-secondary">← 戻る</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
