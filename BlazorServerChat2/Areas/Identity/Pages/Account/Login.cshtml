@page
@model LoginModel

@{
    ViewData["Title"] = "ログイン";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-4">
        <section>
            <form id="account" method="post">
                <h2>あびやログイン</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-floating">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username webauthn" aria-required="true" />
                    <label asp-for="Input.Email" class="form-label">名前</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                    <label asp-for="Input.Password" class="form-label"></label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div>
                    <div class="checkbox">
                        <label asp-for="Input.RememberMe" class="form-label">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
                </div>
                <div class="mt-3">
                    <button type="button" id="passkey-login" class="w-100 btn btn-lg btn-outline-secondary">
                        🔐 パスキーでログイン
                    </button>
                </div>
                <div>
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">あびや登録</a>
                    </p>
                    <p>
                        <a asp-page="./Manage/Passkeys">🔑 パスキーを管理・作成する</a>
                        <small class="text-muted d-block">※ログイン後にパスキーを登録できます</small>
                    </p>
                </div>
            </form>
        </section>
    </div>
    <div class="col-md-6 col-md-offset-2">
        <section>
            <h3>まだアカウント登録してない場合はあびや登録のリンクから</h3>
            <hr />
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ベースパスを取得
        const basePath = document.querySelector('base')?.getAttribute('href')?.replace(/\/$/, '') || '';
        
        document.getElementById('passkey-login').addEventListener('click', async function() {
            const emailInput = document.querySelector('input[name="Input.Email"]');
            const email = emailInput?.value || '';
            
            try {
                // パスキー要求オプションを取得
                const optionsResponse = await fetch(basePath + '/Account/PasskeyRequestOptions', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ email: email })
                });

                if (!optionsResponse.ok) {
                    const error = await optionsResponse.json();
                    alert('パスキーオプションの取得に失敗しました: ' + (error.error || 'Unknown error'));
                    return;
                }

                const options = await optionsResponse.json();
                
                // WebAuthn credentials.get を呼び出し
                const getOptions = {
                    publicKey: {
                        challenge: base64UrlToArrayBuffer(options.challenge),
                        timeout: options.timeout,
                        rpId: options.rpId,
                        allowCredentials: (options.allowCredentials || []).map(c => ({
                            id: base64UrlToArrayBuffer(c.id),
                            type: c.type,
                            transports: c.transports
                        })),
                        userVerification: options.userVerification || 'preferred'
                    }
                };

                const credential = await navigator.credentials.get(getOptions);
                
                if (!credential) {
                    alert('パスキー認証がキャンセルされました');
                    return;
                }

                // credential を JSON に変換してサーバーに送信
                const credentialJson = credentialToJson(credential);
                
                // パスキーでサインイン
                const signInResponse = await fetch(basePath + '/Account/PasskeySignIn', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ credentialJson: credentialJson, returnUrl: '@Model.ReturnUrl' })
                });

                if (signInResponse.ok) {
                    const result = await signInResponse.json();
                    window.location.href = result.returnUrl || '/';
                } else {
                    const error = await signInResponse.json();
                    alert('パスキーサインインに失敗しました: ' + (error.error || 'Unknown error'));
                }

            } catch (error) {
                console.error('パスキーログインエラー:', error);
                alert('パスキーログインに失敗しました: ' + error.message);
            }
        });

        function base64UrlToArrayBuffer(base64Url) {
            const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            const padding = '='.repeat((4 - base64.length % 4) % 4);
            const binary = atob(base64 + padding);
            const bytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) {
                bytes[i] = binary.charCodeAt(i);
            }
            return bytes.buffer;
        }

        function arrayBufferToBase64Url(buffer) {
            const bytes = new Uint8Array(buffer);
            let binary = '';
            for (let i = 0; i < bytes.length; i++) {
                binary += String.fromCharCode(bytes[i]);
            }
            return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
        }

        function credentialToJson(credential) {
            if (typeof credential.toJSON === 'function') {
                try {
                    return JSON.stringify(credential.toJSON());
                } catch (e) {
                    console.warn('credential.toJSON() failed, using manual serialization');
                }
            }

            const response = credential.response;
            const result = {
                id: credential.id,
                rawId: arrayBufferToBase64Url(credential.rawId),
                type: credential.type,
                response: {
                    authenticatorData: arrayBufferToBase64Url(response.authenticatorData),
                    clientDataJSON: arrayBufferToBase64Url(response.clientDataJSON),
                    signature: arrayBufferToBase64Url(response.signature)
                }
            };

            if (response.userHandle) {
                result.response.userHandle = arrayBufferToBase64Url(response.userHandle);
            }

            if (credential.authenticatorAttachment) {
                result.authenticatorAttachment = credential.authenticatorAttachment;
            }

            return JSON.stringify(result);
        }
    </script>
}
