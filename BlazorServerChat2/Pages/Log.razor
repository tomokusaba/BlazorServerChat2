@page "/log"
@using BlazorServerChat2.Services
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject JwtService JwtService
@inject AuthenticationStateProvider AuthStateProvider
@inject PersistentComponentState PersistentState

@* クライアントコンポーネントをInteractiveAutoでレンダリング 📜 *@
<BlazorServerChat2.Client.Pages.LogClient 
    @rendermode="@(new InteractiveAutoRenderMode(prerender: false))"
    InitialJwtToken="@_jwtToken" />

@code {
    private string? _jwtToken;
    private string? _userId;
    private PersistingComponentStateSubscription? _subscription;

    protected override async Task OnInitializedAsync()
    {
        if (PersistentState.TryTakeFromJson<JwtAuthState>("jwt_auth_log", out var restored) && restored != null)
        {
            _jwtToken = restored.Token;
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            var userName = user.Identity.Name ?? string.Empty;
            var roles = user.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();

            _jwtToken = JwtService.GenerateToken(_userId, userName, roles);
            _subscription = PersistentState.RegisterOnPersisting(PersistJwtAsync, RenderMode.InteractiveAuto);
        }
    }

    private Task PersistJwtAsync()
    {
        if (!string.IsNullOrEmpty(_jwtToken))
        {
            PersistentState.PersistAsJson("jwt_auth_log", new JwtAuthState { Token = _jwtToken });
        }
        return Task.CompletedTask;
    }

    public void Dispose() => _subscription?.Dispose();

    private class JwtAuthState { public string Token { get; set; } = string.Empty; }
}
