@page "/log"
@rendermode InteractiveAuto
@using BlazorServerChat2.Shared.Models
@using System.Net.Http.Json

@inject HttpClient Http

<FluentLabel Typo="Typography.Subject">あびやログ</FluentLabel>

@if (isLoading)
{
    <FluentProgressRing />
}
else if (chats != null)
{
    <FluentDataGrid Items="@chats.AsQueryable()" GridTemplateColumns="0.5fr 0.5fr 2fr" MultiLine="true">
        <PropertyColumn Property="@(p => p.Time)" Format="yyyy/MM/dd HH:mm:ss" Title="投稿時刻" />
        <PropertyColumn Property="@(p => p.Name)" Title="名前" />
        <TemplateColumn Title="投稿内容">
            <ChildContent>
                @if (context.Message?.StartsWith("[ほのか]") == true)
                {
                    @((MarkupString)context.Message)
                }
                else
                {
                    @context.Message
                }
            </ChildContent>
        </TemplateColumn>
    </FluentDataGrid>
}

@code {
    private List<ChatDto>? chats;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            chats = await Http.GetFromJsonAsync<List<ChatDto>>("/api/chat");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading chats: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
