@attribute [Authorize]
@page "/neta"
@rendermode InteractiveAuto
@using BlazorServerChat2.Shared.Models
@using System.Net.Http.Json

@inject HttpClient Http

<h3>ほのかさんのネタ帳追加</h3>

<FluentTextField @bind-Value="@TextboxValue" Label="ネタ入力" Placeholder="ネタを入力" AriaLabel="ネタを入力" />
<FluentButton OnClick="@AddNeta" Appearance="Appearance.Accent" AriaLabel="ネタを追加">追加</FluentButton>
@if (isSaving)
{
    <FluentProgressRing Style="width: 20px; height: 20px;" role="status" aria-label="保存中" />
}
<br />
例）「はどこのプロ野球チームが好きなの？」と入れると「○○さんはどこのプロ野球チームが好きなの？」と質問してくれます。

@if (isLoading)
{
    <FluentProgressRing role="status" aria-label="読み込み中" />
}
else if (netaMastars != null)
{
    <FluentDataGrid Items="@netaMastars.AsQueryable()" aria-label="ネタ一覧">
        <PropertyColumn Property="@(p => p.Neta)" Title="ほのかさんのネタ帳" />
    </FluentDataGrid>
}

@code {
    private string TextboxValue = string.Empty;
    private List<NetaDto>? netaMastars;
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadNetas();
    }

    private async Task LoadNetas()
    {
        try
        {
            isLoading = true;
            netaMastars = await Http.GetFromJsonAsync<List<NetaDto>>("/api/neta");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading netas: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddNeta()
    {
        if (string.IsNullOrWhiteSpace(TextboxValue))
            return;

        try
        {
            isSaving = true;
            var response = await Http.PostAsJsonAsync("/api/neta", new { Neta = TextboxValue });
            if (response.IsSuccessStatusCode)
            {
                TextboxValue = string.Empty;
                await LoadNetas();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding neta: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
