@attribute [Authorize]
@page "/"
@using BlazorServerChat2.Services
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject JwtService JwtService
@inject AuthenticationStateProvider AuthStateProvider
@inject PersistentComponentState PersistentState

@* クライアントコンポーネントをInteractiveAutoでレンダリング 🚀 *@
<BlazorServerChat2.Client.Pages.IndexAutoClient 
    @rendermode="@(new InteractiveAutoRenderMode(prerender: false))"
    InitialJwtToken="@_jwtToken"
    InitialUserId="@_userId"
    InitialUserName="@_userName" />

@code {
    private string? _jwtToken;
    private string? _userId;
    private string? _userName;
    private PersistingComponentStateSubscription? _subscription;

    protected override async Task OnInitializedAsync()
    {
        // PersistentStateから復元を試みる
        if (PersistentState.TryTakeFromJson<JwtAuthState>("jwt_auth", out var restored) && restored != null)
        {
            _jwtToken = restored.Token;
            _userId = restored.UserId;
            _userName = restored.UserName;
            Console.WriteLine($"IndexAuto: JWT restored for {_userName} 🔄");
            return;
        }

        // サーバー側でJWTを生成
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            _userName = user.Identity.Name ?? string.Empty;

            var roles = user.Claims
                .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                .Select(c => c.Value)
                .ToList();

            _jwtToken = JwtService.GenerateToken(_userId, _userName, roles);
            Console.WriteLine($"IndexAuto: JWT generated for {_userName} 🎫");

            // PersistentStateに永続化登録
            _subscription = PersistentState.RegisterOnPersisting(PersistJwtAsync, RenderMode.InteractiveAuto);
        }
    }

    private Task PersistJwtAsync()
    {
        if (!string.IsNullOrEmpty(_jwtToken))
        {
            PersistentState.PersistAsJson("jwt_auth", new JwtAuthState
            {
                Token = _jwtToken,
                UserId = _userId ?? string.Empty,
                UserName = _userName ?? string.Empty
            });
            Console.WriteLine($"IndexAuto: JWT persisted for {_userName} 💾");
        }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _subscription?.Dispose();
    }

    private class JwtAuthState
    {
        public string Token { get; set; } = string.Empty;
        public string UserId { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
    }
}
