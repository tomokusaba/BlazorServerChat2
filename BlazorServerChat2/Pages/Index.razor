    private async Task TalkGPT(string message)
    {
        if (_isChatting && !string.IsNullOrWhiteSpace(message))
        {
            // 残高チェック（500円必要）
            var currentOsaifu = DbContext.Osaifus.Find(_username);
            int currentBalance = currentOsaifu?.Kingaku ?? 0;
            if (currentBalance < 500)
            {
                // 残高不足メッセージを表示
                Chat errorChat = new Chat();
                errorChat.Name = _username ?? string.Empty;
                errorChat.Message = $"[ほのか] : {_username}さん、ごめんね！残高が足りないみたい…💸 私とお話するには500円必要だよ！（現在: {currentBalance:N0}円）";
                errorChat.UserId = UserId ?? string.Empty;
                DbContext.Chats.Add(errorChat);
                DbContext.SaveChanges();
                Message errorMessage = new Message(_username ?? string.Empty, errorChat.Message, false, UserId ?? string.Empty);
                await clientHub.SendAsync(errorMessage);
                room.SendMsg(UserId ?? string.Empty);
                _newMessage = string.Empty;
                StateHasChanged();
                return;
            }

            Chat chat = new Chat();
            chat.Name = _username ?? string.Empty;
            chat.Message = message;
            chat.UserId = UserId ?? string.Empty;
            Osaifu osaifu1 = new();
            DbContext.Chats.Add(chat);
            var osaifu = DbContext.Osaifus.Find(_username);
            if (osaifu != null)
            {
                osaifu.Kingaku = osaifu.Kingaku - 500;  // ほのかに話しかけると500円消費
                Kingaku = osaifu.Kingaku;
            }
            else
            {
                osaifu1.Kingaku = -500;  // 新規ユーザーは-500円からスタート
                osaifu1.Name = _username;
                DbContext.Add(osaifu1);
                Kingaku = -500;
            }
            DbContext.SaveChanges();
            Message message1 = new Message(_username ?? string.Empty, message, true, UserId ?? string.Empty);

            await clientHub.SendAsync(message1);
            room.SendMsg(UserId ?? string.Empty);
            _newMessage = string.Empty;
            StateHasChanged();

            string response = await agentFrameworkLogic.Run(message);
            chat = new();
            chat.Name = _username ?? string.Empty;
            chat.Message = $"[ほのか] : {_username}さん{response}";
            chat.UserId = UserId ?? string.Empty;
            DbContext.Chats.Add(chat);
            DbContext.SaveChanges();
            Message message2 = new Message(_username ?? string.Empty, chat.Message, false, UserId ?? string.Empty);

            await clientHub.SendAsync(message2);
            room.SendMsg(UserId ?? string.Empty);
            _newMessage = string.Empty;

            StateHasChanged();
        }

    }

    /// <summary>
    /// ほのかとみずきのグループチャットを開始する
    /// 最大5回のやり取りで会話を続ける（逐次表示）
    /// </summary>
    /// <param name="message">ユーザーからのメッセージ</param>
    private async Task TalkGroupChat(string message)
    {
        if (_isChatting && !string.IsNullOrWhiteSpace(message))
        {
            // 残高チェック（1000円必要 - 二人と話すとお得！）
            var currentOsaifu = DbContext.Osaifus.Find(_username);
            int currentBalance = currentOsaifu?.Kingaku ?? 0;
            if (currentBalance < 1000)
            {
                // 残高不足メッセージを表示
                Chat errorChat = new Chat();
                errorChat.Name = _username ?? string.Empty;
                errorChat.Message = $"[ほのか] : {_username}さん、グループチャットはお得だよ！👑 私とみずきちゃん両方とお話するには1,000円だけでいいの！（現在: {currentBalance:N0}円）";
                errorChat.UserId = UserId ?? string.Empty;
                DbContext.Chats.Add(errorChat);
                DbContext.SaveChanges();
                Message errorMessage = new Message(_username ?? string.Empty, errorChat.Message, false, UserId ?? string.Empty);
                await clientHub.SendAsync(errorMessage);
                room.SendMsg(UserId ?? string.Empty);
                _newMessage = string.Empty;
                StateHasChanged();
                return;
            }

            // ユーザーのメッセージをチャットに追加
            Chat chat = new Chat();
            chat.Name = _username ?? string.Empty;
            chat.Message = message;
            chat.UserId = UserId ?? string.Empty;
            Osaifu osaifu1 = new();
            DbContext.Chats.Add(chat);
            var osaifu = DbContext.Osaifus.Find(_username);
            if (osaifu != null)
            {
                osaifu.Kingaku = osaifu.Kingaku - 1000;  // グループチャット（ほのか＋みずき）は1000円消費 - お得！
                Kingaku = osaifu.Kingaku;
            }
            else
            {
                osaifu1.Kingaku = -1000;  // 新規ユーザーは-1000円からスタート
                osaifu1.Name = _username;
                DbContext.Add(osaifu1);
                Kingaku = -1000;
            }
            DbContext.SaveChanges();
            Message message1 = new Message(_username ?? string.Empty, message, true, UserId ?? string.Empty);

            await clientHub.SendAsync(message1);
            room.SendMsg(UserId ?? string.Empty);
            _newMessage = string.Empty;
            StateHasChanged();

            // グループチャットを実行（逐次コールバック）
            await agentFrameworkLogic.RunGroupChat(message, async (agentName, responseText) =>
            {
                // 各エージェントの応答を即座にチャットに追加
                var newChat = new Chat();
                newChat.Name = _username ?? string.Empty;
                // [ほのか] または [みずき] で始まるメッセージにする
                newChat.Message = $"[{agentName}] : {_username}さん{responseText}";
                newChat.UserId = UserId ?? string.Empty;
                DbContext.Chats.Add(newChat);
                await DbContext.SaveChangesAsync();
                
                Message newMessage = new Message(_username ?? string.Empty, newChat.Message, false, UserId ?? string.Empty);
                await clientHub.SendAsync(newMessage);
                room.SendMsg(UserId ?? string.Empty);
                
                // UIを即座に更新
                await InvokeAsync(StateHasChanged);
            });

            _newMessage = string.Empty;
            StateHasChanged();
        }
    }

    private async Task OnKeyDownAsync(FluentKeyCodeEventArgs args)
    {
        if (args.Key == KeyCode.Enter)
        {
            await SendAsync(_newMessage);
        }
    }



    /// <summary>
    /// メッセージ送信
    /// ここではメッセージ内容をつくりメッセージ送信そのものはクライアント接続管理クラスにて行う
    /// </summary>
    /// <param name="message">発言内容</param>
    /// <returns></returns>
    private async Task SendAsync(string message, bool IsSystem = false)
    {
        if (_isChatting && !string.IsNullOrWhiteSpace(message))
        {
            if (message.StartsWith("[ほのか]") && !IsSystem)
            {
                return;
            }
            Chat chat = new Chat();
            chat.Name = _username ?? string.Empty;
            chat.Message = message;
            chat.UserId = UserId ?? string.Empty;
            Osaifu osaifu1 = new();
            DbContext.Chats.Add(chat);
            agentFrameworkLogic.NonGenerateMessage(message);
            var osaifu = DbContext.Osaifus.Find(_username);
            if (osaifu != null)
            {
                osaifu.Kingaku = osaifu.Kingaku + 100;
                Kingaku = osaifu.Kingaku;
            }
            else
            {
                osaifu1.Kingaku = 100;
                osaifu1.Name = _username;
                DbContext.Add(osaifu1);
                Kingaku = 100;
            }
            DbContext.SaveChanges();
            Message message1 = new Message(_username ?? string.Empty, message, true, UserId ?? string.Empty);

            await clientHub.SendAsync(message1);
            room.SendMsg(UserId ?? string.Empty);
            _newMessage = string.Empty;
            StateHasChanged();
        }
    }

    /// <summary>
    /// メッセージ
    /// </summary>
    public class Message
    {
        public Message(string username, string body, bool mine, string userid)
        {
            Username = username;
            Body = body;
            Mine = mine;
            UserId = userid;
        }

        /// <summary>
        /// メッセージ送信元ユーザ名
        /// </summary>
        public string Username { get; set; }
        /// <summary>
        /// メッセージ本体
        /// </summary>
        public string Body { get; set; }
        /// <summary>
        /// 自分の送信したメッセージかどうか
        /// </summary>
        public bool Mine { get; set; }
        public int ConnectionCount { get; set; }
        /// <summary>
        /// メッセージ送信日時
        /// </summary>
        public DateTime PostTime { get; set; } = DateTime.Now;
        /// <summary>
        /// メッセージ送信元ユーザID
        /// </summary>
        public string UserId { get; set; } = String.Empty;
        /// <summary>
        /// 管理人発言かどうか（ほのか または みずき）
        /// </summary>
        public bool IsNotice => Body.StartsWith("[ほのか]") || Body.StartsWith("[みずき]");

        /// <summary>
        /// ほのかの発言かどうか
        /// </summary>
        public bool IsHonoka => Body.StartsWith("[ほのか]");

        /// <summary>
        /// みずきの発言かどうか
        /// </summary>
        public bool IsMizuki => Body.StartsWith("[みずき]");

        /// <summary>
        /// エージェント発言用の背景色（Fluent UIカラートークン使用、ダークモード対応）
        /// </summary>
        public string NoticeBackgroundColor
        {
            get
            {
                if (IsHonoka)
                    return "color-mix(in srgb, var(--accent-fill-rest) 15%, var(--neutral-layer-1))"; // ほのか: 薄いアクセント色
                if (IsMizuki)
                    return "var(--neutral-layer-3)";       // みずき: ニュートラル
                return "var(--neutral-layer-2)";
            }
        }

        /// <summary>
        /// エージェント発言用のテキスト色（Fluent UIカラートークン使用、ダークモード対応）
        /// </summary>
        public string NoticeTextColor
        {
            get
            {
                if (IsHonoka)
                    return "var(--accent-foreground-rest)"; // アクセント色のテキスト
                if (IsMizuki)
                    return "var(--neutral-foreground-rest)";  // 標準テキスト色
                return "var(--neutral-foreground-rest)";
            }
        }

        /// <summary>
        /// エージェント発言用のスタイル（背景色＋テキスト色）
        /// </summary>
        public string NoticeStyle => $"background-color:{NoticeBackgroundColor};color:{NoticeTextColor};";

        public string CSS => Mine ? "sent" : "received";
    }

}