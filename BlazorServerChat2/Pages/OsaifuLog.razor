@page "/osaifu"
@using BlazorServerChat2.Data

@inject ApplicationDbContext DbContext

<h3>お財布リスト</h3>

@if (osaifus != null)
{
    @*<RadzenDataGrid Data=@osaifus TItem="Osaifu">
        <Columns>
            <RadzenDataGridColumn TItem="Osaifu" property="Name" Title="名前" ></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Osaifu" property="Kingaku" Title="金額"></RadzenDataGridColumn>

        </Columns>
    </RadzenDataGrid>*@
    <FluentDataGrid Items="@osaifus.AsQueryable()">
        <PropertyColumn Property="@(p => p.Name)" Title="名前" />
        <PropertyColumn Property="@(p => p.Kingaku)" Title="金額" />
    </FluentDataGrid>
}

@code {
    IEnumerable<Osaifu> osaifus = default!;

    protected override void OnInitialized()
    {
        osaifus = DbContext.Osaifus.ToList();
    }
}
