@attribute [Authorize]
@page "/config"
@rendermode InteractiveAuto
@using BlazorServerChat2.Shared.Models
@using System.Net.Http.Json
@using Radzen.Blazor

@inject HttpClient Http

<PageTitle>あびや設定</PageTitle>

<FluentLabel Typo="Typography.PageTitle">あびやアイコン設定</FluentLabel>

@if (isLoading)
{
    <FluentProgressRing />
}
else
{
    <RadzenDropDownDataGrid TValue="int" Data="@iconMasters" PageSize="15" Change="@(args => OnChange(args))" TextProperty="IconName" ValueProperty="IconNumber" Value="@selectedIconNumber">
        <Columns>
            <RadzenDropDownDataGridColumn Property="IconName" />
        </Columns>
    </RadzenDropDownDataGrid>
    @debug
    @if (!string.IsNullOrEmpty(selectedIconBase64))
    {
        <img src="data:image/png;base64,@selectedIconBase64" />
    }
    <RadzenColorPicker @bind-Value="@color" />

    <RadzenButton Text="保存" Click="@SaveColor" />
    @if (isSaving)
    {
        <FluentProgressRing Style="width: 20px; height: 20px;" />
    }
}

@code {
    private List<IconDto>? iconMasters;
    private string? debug;
    private int selectedIconNumber;
    private string color = "rgb(0,0,0)";
    private string? selectedIconBase64;
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // アイコン一覧を取得
            iconMasters = await Http.GetFromJsonAsync<List<IconDto>>("/api/usersettings/icons");
            
            // 現在のユーザー設定を取得
            var settings = await Http.GetFromJsonAsync<UserChatSettingDto>("/api/usersettings");
            if (settings != null)
            {
                selectedIconNumber = settings.IconNumber;
                color = settings.BackGroundColor;
                
                // 選択中のアイコンを表示
                var selectedIcon = iconMasters?.FirstOrDefault(i => i.IconNumber == selectedIconNumber);
                selectedIconBase64 = selectedIcon?.IconBase64;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading config: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnChange(object value)
    {
        debug = value.ToString();
        selectedIconNumber = (int)value;
        
        // 選択したアイコンを表示
        var selectedIcon = iconMasters?.FirstOrDefault(i => i.IconNumber == selectedIconNumber);
        selectedIconBase64 = selectedIcon?.IconBase64;
        
        // 設定を保存
        await SaveSettings();
    }

    private async Task SaveColor()
    {
        await SaveSettings();
    }

    private async Task SaveSettings()
    {
        try
        {
            isSaving = true;
            var request = new UserChatSettingDto
            {
                IconNumber = selectedIconNumber,
                BackGroundColor = color
            };
            await Http.PutAsJsonAsync("/api/usersettings", request);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving settings: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
