@attribute [Authorize]
@page "/config"
@rendermode InteractiveServer
@using BlazorServerChat2.Shared.Models
@using BlazorServerChat2.Services
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Radzen.Blazor

@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject JwtService JwtService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>あびや設定</PageTitle>

<FluentLabel Typo="Typography.PageTitle">あびやアイコン設定</FluentLabel>

@if (isLoading)
{
    <FluentProgressRing role="status" aria-label="読み込み中" />
}
else
{
    <RadzenDropDownDataGrid TValue="int" Data="@iconMasters" PageSize="15" Change="@(args => OnChange(args))" TextProperty="IconName" ValueProperty="IconNumber" Value="@selectedIconNumber" aria-label="アイコン選択">
        <Columns>
            <RadzenDropDownDataGridColumn Property="IconName" />
        </Columns>
    </RadzenDropDownDataGrid>
    @debug
    @if (!string.IsNullOrEmpty(selectedIconBase64))
    {
        <img src="data:image/png;base64,@selectedIconBase64" alt="選択中のアイコン" />
    }
    <RadzenColorPicker @bind-Value="@color" aria-label="背景色の選択" />

    <RadzenButton Text="保存" Click="@SaveColor" aria-label="設定を保存" />
    @if (isSaving)
    {
        <FluentProgressRing Style="width: 20px; height: 20px;" role="status" aria-label="保存中" />
    }
}

@code {
    private List<IconDto>? iconMasters;
    private string? debug;
    private int selectedIconNumber;
    private string color = "rgb(0,0,0)";
    private string? selectedIconBase64;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? _jwtToken;

    private string ToApiPath(string relativePath)
    {
        var baseUri = NavigationManager.BaseUri.TrimEnd('/');
        return $"{baseUri}{relativePath}";
    }

    protected override async Task OnInitializedAsync()
    {
        // JWT トークンを生成 🔐
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            var userName = user.Identity.Name ?? string.Empty;
            var roles = user.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
            _jwtToken = JwtService.GenerateToken(userId, userName, roles);
        }

        try
        {
            // アイコン一覧を取得
            iconMasters = await GetWithJwtAsync<List<IconDto>>(ToApiPath("/api/usersettings/icons"));
            
            // 現在のユーザー設定を取得
            var settings = await GetWithJwtAsync<UserChatSettingDto>(ToApiPath("/api/usersettings"));
            if (settings != null)
            {
                selectedIconNumber = settings.IconNumber;
                color = settings.BackGroundColor;
                
                // 選択中のアイコンを表示
                var selectedIcon = iconMasters?.FirstOrDefault(i => i.IconNumber == selectedIconNumber);
                selectedIconBase64 = selectedIcon?.IconBase64;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading config: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<T?> GetWithJwtAsync<T>(string requestUri)
    {
        var request = new HttpRequestMessage(HttpMethod.Get, requestUri);
        if (!string.IsNullOrEmpty(_jwtToken))
        {
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", _jwtToken);
        }
        var response = await Http.SendAsync(request);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<T>();
    }

    private async Task PutWithJwtAsync<T>(string requestUri, T content)
    {
        var request = new HttpRequestMessage(HttpMethod.Put, requestUri);
        request.Content = JsonContent.Create(content);
        if (!string.IsNullOrEmpty(_jwtToken))
        {
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", _jwtToken);
        }
        var response = await Http.SendAsync(request);
        response.EnsureSuccessStatusCode();
    }

    private async Task OnChange(object value)
    {
        debug = value.ToString();
        selectedIconNumber = (int)value;
        
        // 選択したアイコンを表示
        var selectedIcon = iconMasters?.FirstOrDefault(i => i.IconNumber == selectedIconNumber);
        selectedIconBase64 = selectedIcon?.IconBase64;
        
        // 設定を保存
        await SaveSettings();
    }

    private async Task SaveColor()
    {
        await SaveSettings();
    }

    private async Task SaveSettings()
    {
        try
        {
            isSaving = true;
            var request = new UserChatSettingDto
            {
                IconNumber = selectedIconNumber,
                BackGroundColor = color
            };
            await PutWithJwtAsync(ToApiPath("/api/usersettings"), request);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving settings: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
