@page "/api-test"
@rendermode InteractiveAuto
@using BlazorServerChat2.Shared.Models
@using BlazorServerChat2.Client
@using BlazorServerChat2.Services
@using System.Net.Http.Json
@using System.Runtime.InteropServices
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject AuthenticatedHttpClientFactory? AuthHttpFactory

<PageTitle>API テスト</PageTitle>

<h3>🧪 Web API テストページ</h3>
<p>このページはInteractive Autoモードで動作しています（初回はサーバー、以降はWASM）</p>

<div style="margin-bottom: 20px;">
    <h4>📊 ルームステータス</h4>
    <button class="btn btn-primary" @onclick="LoadRoomStatus" aria-label="ルームステータスを取得">ルームステータス取得</button>
    @if (roomStatus != null)
    {
        <div style="background-color: #f0f0f0; padding: 10px; margin-top: 10px; border-radius: 5px;">
            <p><strong>在室人数:</strong> @roomStatus.RoomCount 人</p>
            <p><strong>在室者:</strong> @string.Join(", ", roomStatus.RoomNames ?? [])</p>
        </div>
    }
</div>

<div style="margin-bottom: 20px;">
    <h4>💬 チャット履歴</h4>
    <button class="btn btn-primary" @onclick="LoadChats" aria-label="チャット履歴を取得">チャット履歴取得</button>
    @if (chats != null && chats.Any())
    {
        <table style="width: 100%; border-collapse: collapse; margin-top: 10px;" aria-label="チャット履歴のテーブル">
            <thead>
                <tr style="background-color: #333; color: white;">
                    <th scope="col" style="padding: 8px; text-align: left;">時刻</th>
                    <th scope="col" style="padding: 8px; text-align: left;">名前</th>
                    <th scope="col" style="padding: 8px; text-align: left;">メッセージ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var chat in chats.Take(10))
                {
                    <tr style="border-bottom: 1px solid #ddd;">
                        <td style="padding: 8px;">@chat.Time.ToString("yyyy/MM/dd HH:mm")</td>
                        <td style="padding: 8px;">@chat.Name</td>
                        <td style="padding: 8px;">@chat.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div style="margin-bottom: 20px;">
    <h4>💰 お財布情報</h4>
    <button class="btn btn-primary" @onclick="LoadOsaifu" aria-label="お財布情報を取得">お財布取得</button>
    @if (osaifu != null)
    {
        <div style="background-color: #e8f5e9; padding: 10px; margin-top: 10px; border-radius: 5px;">
            <p><strong>名前:</strong> @osaifu.Name</p>
            <p><strong>残高:</strong> @osaifu.Kingaku.ToString("N0") 円</p>
        </div>
    }
</div>

<div style="margin-bottom: 20px;">
    <h4>🎨 アイコン一覧</h4>
    <button class="btn btn-primary" @onclick="LoadIcons" aria-label="アイコン一覧を取得">アイコン取得</button>
    @if (icons != null && icons.Any())
    {
        <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px;">
            @foreach (var icon in icons.Take(10))
            {
                <div style="text-align: center;">
                    @if (!string.IsNullOrEmpty(icon.IconBase64))
                    {
                        <img src="data:image/png;base64,@icon.IconBase64" style="width: 48px; height: 48px;" alt="@icon.IconName" />
                    }
                    <p style="font-size: 12px;">@icon.IconName</p>
                </div>
            }
        </div>
    }
</div>

<div style="margin-top: 20px; padding: 10px; background-color: #e3f2fd; border-radius: 5px;">
    <h4>🔧 デバッグ情報</h4>
    <p><strong>実行環境:</strong> @_debugEnvironment</p>
    <p><strong>BaseUri:</strong> @NavigationManager.BaseUri</p>
    <p><strong>最後のリクエストURL:</strong> @_debugLastUrl</p>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div style="background-color: #ffebee; color: #c62828; padding: 10px; border-radius: 5px; margin-top: 20px;" role="alert" aria-live="assertive">
        <strong>エラー:</strong> @errorMessage
    </div>
}

@code {
    private RoomStatusDto? roomStatus;
    private List<ChatDto>? chats;
    private OsaifuDto? osaifu;
    private List<IconDto>? icons;
    private string? errorMessage;
    private string? requestUrl; // デバッグ用
    private string _debugEnvironment = "不明";
    private string _debugLastUrl = "";

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            bool isWasm = RuntimeInformation.IsOSPlatform(OSPlatform.Create("BROWSER"));
            _debugEnvironment = isWasm ? "WASM (ブラウザ)" : "Server";
            StateHasChanged();
        }
    }

    /// <summary>
    /// APIパスをベースパス対応に変換（IISサブアプリケーション対応）
    /// </summary>
    private string ToApiPath(string relativePath)
    {
        var baseUri = NavigationManager.BaseUri.TrimEnd('/');
        return $"{baseUri}{relativePath}";
    }

    /// <summary>
    /// 認証付きGETリクエスト（WASM/Server両対応）
    /// </summary>
    private async Task<T?> GetAuthenticatedAsync<T>(string relativePath)
    {
        bool isWasm = RuntimeInformation.IsOSPlatform(OSPlatform.Create("BROWSER"));
        _debugEnvironment = isWasm ? "WASM (ブラウザ)" : "Server";
        _debugLastUrl = ToApiPath(relativePath);
        
        if (isWasm)
        {
            // WASM: BrowserRequestCredentialsを使って認証Cookie付きリクエスト
            return await Http.GetWithCredentialsAsync<T>(_debugLastUrl);
        }
        else if (AuthHttpFactory != null)
        {
            // Server: AuthenticatedHttpClientFactoryを使用
            var authClient = AuthHttpFactory.CreateAuthenticatedClient();
            authClient.BaseAddress = new Uri(NavigationManager.BaseUri);
            _debugLastUrl = relativePath.TrimStart('/');
            return await authClient.GetFromJsonAsync<T>(_debugLastUrl);
        }
        
        return default;
    }

    private async Task LoadRoomStatus()
    {
        try
        {
            errorMessage = null;
            requestUrl = ToApiPath("/api/chat/room-status");
            Console.WriteLine($"Requesting: {requestUrl}");
            // ルームステータスは認証不要
            roomStatus = await Http.GetFromJsonAsync<RoomStatusDto>(requestUrl);
        }
        catch (Exception ex)
        {
            errorMessage = $"ルームステータス取得エラー: {ex.Message} (URL: {requestUrl})";
        }
    }

    private async Task LoadChats()
    {
        try
        {
            errorMessage = null;
            // チャットは認証必要
            chats = await GetAuthenticatedAsync<List<ChatDto>>("/api/chat");
        }
        catch (Exception ex)
        {
            errorMessage = $"チャット履歴取得エラー: {ex.Message}";
        }
    }

    private async Task LoadOsaifu()
    {
        try
        {
            errorMessage = null;
            // お財布は認証必要
            osaifu = await GetAuthenticatedAsync<OsaifuDto>("/api/osaifu");
        }
        catch (Exception ex)
        {
            errorMessage = $"お財布取得エラー: {ex.Message}";
        }
    }

    private async Task LoadIcons()
    {
        try
        {
            errorMessage = null;
            // アイコンは認証不要
            icons = await Http.GetFromJsonAsync<List<IconDto>>(ToApiPath("/api/usersettings/icons"));
        }
        catch (Exception ex)
        {
            errorMessage = $"アイコン取得エラー: {ex.Message}";
        }
    }
}
