@* ログページ - クライアントコンポーネント 📜 *@
@using BlazorServerChat2.Shared.Models
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using System.Runtime.InteropServices

@inject HttpClient Http
@inject NavigationManager NavigationManager

<FluentLabel Typo="Typography.Subject">あびやログ</FluentLabel>
<FluentBadge Appearance="Appearance.Neutral">@(_isWasm ? "WASM 🌐" : "Server 🖥️")</FluentBadge>

@if (isLoading)
{
    <FluentProgressRing />
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <FluentMessageBar Title="エラー" Intent="MessageIntent.Error">
        @_errorMessage
    </FluentMessageBar>
}
else if (chats == null || chats.Count == 0)
{
    <FluentMessageBar Title="情報" Intent="MessageIntent.Info">
        ログデータがありません 📭
    </FluentMessageBar>
}
else
{
    <FluentDataGrid Items="@chats.AsQueryable()" GridTemplateColumns="0.5fr 0.5fr 2fr" MultiLine="true">
        <PropertyColumn Property="@(p => p.Time)" Format="yyyy/MM/dd HH:mm:ss" Title="投稿時刻" />
        <PropertyColumn Property="@(p => p.Name)" Title="名前" />
        <TemplateColumn Title="投稿内容">
            <ChildContent>
                @if (context.Message?.StartsWith("[ほのか]") == true)
                {
                    @((MarkupString)context.Message)
                }
                else
                {
                    @context.Message
                }
            </ChildContent>
        </TemplateColumn>
    </FluentDataGrid>
}

@code {
    [Parameter] public string? InitialJwtToken { get; set; }

    private List<ChatDto>? chats;
    private bool isLoading = true;
    private bool _isWasm = false;
    private string? _jwtToken;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _isWasm = RuntimeInformation.IsOSPlatform(OSPlatform.Create("BROWSER"));
        _jwtToken = InitialJwtToken;

        try
        {
            var apiPath = ToApiPath("/api/chat");
            Console.WriteLine($"[LogClient] Fetching from: {apiPath}");
            Console.WriteLine($"[LogClient] JWT Token exists: {!string.IsNullOrEmpty(_jwtToken)}");
            
            chats = await GetWithJwtAsync<List<ChatDto>>(apiPath);
            Console.WriteLine($"[LogClient] Loaded {chats?.Count ?? 0} chats");
        }
        catch (HttpRequestException httpEx)
        {
            _errorMessage = $"API呼び出しエラー: {httpEx.StatusCode} - {httpEx.Message}";
            Console.WriteLine($"[LogClient] HTTP Error: {httpEx.StatusCode} - {httpEx.Message}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"エラー: {ex.Message}";
            Console.WriteLine($"[LogClient] Error loading chats: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string ToApiPath(string relativePath)
    {
        var baseUri = NavigationManager.BaseUri.TrimEnd('/');
        return $"{baseUri}{relativePath}";
    }

    private async Task<T?> GetWithJwtAsync<T>(string requestUri)
    {
        var request = new HttpRequestMessage(HttpMethod.Get, requestUri);
        if (!string.IsNullOrEmpty(_jwtToken))
        {
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", _jwtToken);
        }
        request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
        var response = await Http.SendAsync(request);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<T>();
    }
}
